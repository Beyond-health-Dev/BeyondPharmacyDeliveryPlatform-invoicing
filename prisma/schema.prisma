generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users              User[]
  deliveryZones      DeliveryZone[]
  orders             Order[]
  recurringOrders    RecurringOrder[]
  patients           Patient[]
  invoices           Invoice[]
  notifications      Notification[]
  externalPlans      ExternalPlan[]
  externalDispatches ExternalDispatch[]
  reminders          Reminder[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("PHARMACY_ADMIN") // PHARMACY_ADMIN | DRIVER
  phone        String?
  isActive     Boolean  @default(true)
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdOrders           Order[]              @relation("OrderCreatedBy")
  assignedDeliveries      Order[]              @relation("OrderAssignedDriver")
  defaultZones            DeliveryZone[]       @relation("ZoneDefaultDriver")
  recurringOrders         RecurringOrder[]
  assignedRecurringOrders RecurringOrder[]     @relation("RecurringOrderAssignedDriver")
  recurringSkips          RecurringOrderSkip[]
  generatedInvoices       Invoice[]
  driverInvoices          Invoice[]            @relation("InvoiceDriver")
  externalPlans           ExternalPlan[]       @relation("ExternalPlanProviderUser")
  externalDispatches      ExternalDispatch[]   @relation("ExternalDispatchProviderUser")
}

model Patient {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  address    String
  city       String
  postalCode String
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recurringOrders RecurringOrder[]
  addresses       Address[]
  orders          Order[]

  @@index([storeId, name])
}

model Address {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  label      String   @default("Primary")
  address    String
  city       String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders Order[] @relation("OrderDeliveryAddress")

  @@index([patientId])
  @@index([patientId, isDefault])
}

model DeliveryZone {
  id              String   @id @default(cuid())
  name            String
  price           Float
  isActive        Boolean  @default(true)
  defaultDriverId String?
  defaultDriver   User?    @relation("ZoneDefaultDriver", fields: [defaultDriverId], references: [id])
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]
  recurringOrders RecurringOrder[]

  @@unique([name, storeId])
}

model RecurringOrder {
  id                      String       @id @default(cuid())
  patientId               String?
  patient                 Patient?     @relation(fields: [patientId], references: [id])
  patientName             String
  patientPhone            String?
  deliveryAddress         String
  deliveryCity            String
  deliveryPostalCode      String
  deliveryZoneId          String
  deliveryZone            DeliveryZone @relation(fields: [deliveryZoneId], references: [id])
  instructions            String?
  assignedDriverId        String?
  assignedDriver          User?        @relation("RecurringOrderAssignedDriver", fields: [assignedDriverId], references: [id])
  activeDays              String       @default("[1]") // JSON array of day numbers 0=Sun..6=Sat, e.g. "[1,2,3,4,5]"
  recurrenceIntervalWeeks Int          @default(1)
  recurrenceAnchorDate    DateTime     @default(now())
  isOnHold                Boolean      @default(false)
  holdStart               DateTime?
  holdEnd                 DateTime?
  isActive                Boolean      @default(true)
  storeId                 String
  store                   Store        @relation(fields: [storeId], references: [id])
  createdById             String
  createdBy               User         @relation(fields: [createdById], references: [id])
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  orders Order[]
  skips  RecurringOrderSkip[]

  @@index([isActive, isOnHold])
}

model RecurringOrderSkip {
  id               String         @id @default(cuid())
  recurringOrderId String
  recurringOrder   RecurringOrder @relation(fields: [recurringOrderId], references: [id])
  skipDate         DateTime
  // "DAY": a one-day hold from the calendar. "WEEK": Skip This Week, holding
  // the week that starts on skipDate (a Sunday). "WEEK_OVER_DAY": a week skip
  // on a Sunday that also has a one-day hold. Null on rows saved by older
  // code; see src/lib/recurringHolds.ts.
  scope            String?
  reason           String?
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())

  @@unique([recurringOrderId, skipDate])
}

model Order {
  id                 String          @id @default(cuid())
  idempotencyKey     String?         @unique
  patientId          String?
  patient            Patient?        @relation(fields: [patientId], references: [id])
  patientName        String
  patientPhone       String?
  deliveryAddress    String
  deliveryCity       String
  deliveryPostalCode String
  deliveryAddressId  String?
  deliveryAddressRef Address?        @relation("OrderDeliveryAddress", fields: [deliveryAddressId], references: [id])
  deliveryZoneId     String
  deliveryZone       DeliveryZone    @relation(fields: [deliveryZoneId], references: [id])
  deliveryZoneName   String
  priceAtCreation    Float
  instructions       String?
  status             String          @default("PENDING") // PENDING | ASSIGNED | PICKED_UP | IN_TRANSIT | DELIVERED | FAILED | CANCELLED
  cancelledAt        DateTime?
  isInvoiced         Boolean         @default(false)
  completedAt        DateTime?
  failedReason       String?
  attemptCount       Int             @default(1)
  scheduledDate      DateTime
  recurringOrderId   String?
  recurringOrder     RecurringOrder? @relation(fields: [recurringOrderId], references: [id])
  assignedDriverId   String?
  assignedDriver     User?           @relation("OrderAssignedDriver", fields: [assignedDriverId], references: [id])
  storeId            String
  store              Store           @relation(fields: [storeId], references: [id])
  createdById        String
  createdBy          User            @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  invoiceLineItems InvoiceLineItem[]
  notifications    Notification[]

  @@unique([recurringOrderId, scheduledDate])
  @@index([storeId, scheduledDate])
  @@index([storeId, status])
  @@index([storeId, patientId])
  @@index([assignedDriverId, storeId, scheduledDate])
  @@index([isInvoiced, completedAt])
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  periodStart   DateTime
  periodEnd     DateTime
  totalAmount   Float
  status        String   @default("DRAFT") // DRAFT | FINALIZED
  driverId      String?
  driver        User?    @relation("InvoiceDriver", fields: [driverId], references: [id])
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  generatedById String
  generatedBy   User     @relation(fields: [generatedById], references: [id])
  createdAt     DateTime @default(now())

  lineItems InvoiceLineItem[]

  @@index([storeId, driverId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  description String
  amount      Float

  @@index([invoiceId])
  @@index([orderId])
}

model Notification {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  type      String // DELIVERY_FAILED | DELIVERY_REATTEMPT | ORDER_PICKED_UP | SPOKE_DISPATCH_FAILED
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId, isRead])
  @@index([orderId])
  @@index([storeId, createdAt])
}

model ExternalPlan {
  id                     String   @id @default(cuid())
  planKey                String   @unique
  provider               String
  status                 String
  title                  String
  scheduledDate          DateTime
  spokePlanId            String?
  spokeDriverId          String
  selectedProviderUserId String?
  selectedProviderUser   User?    @relation("ExternalPlanProviderUser", fields: [selectedProviderUserId], references: [id])
  lastOperationId        String?
  lastRequestPayload     Json?
  lastResponsePayload    Json?
  errorMessage           String?
  storeId                String
  store                  Store    @relation(fields: [storeId], references: [id])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  dispatches ExternalDispatch[]

  @@index([storeId, provider, scheduledDate])
  @@index([selectedProviderUserId, storeId, scheduledDate])
}

model ExternalDispatch {
  id                     String        @id @default(cuid())
  idempotencyKey         String        @unique
  provider               String
  status                 String
  externalReference      String?
  workflowStep           String?
  externalPlanId         String?
  externalPlan           ExternalPlan? @relation(fields: [externalPlanId], references: [id])
  spokePlanId            String?
  spokeStopId            String?       @unique
  spokeDriverId          String?
  spokeOperationId       String?
  selectedProviderUserId String?
  selectedProviderUser   User?         @relation("ExternalDispatchProviderUser", fields: [selectedProviderUserId], references: [id])
  patientId              String?
  patientName            String
  patientPhone           String?
  deliveryAddress        String
  deliveryCity           String
  deliveryPostalCode     String
  deliveryAddressId      String?
  deliveryZoneId         String
  deliveryZoneName       String
  priceAtCreation        Float
  instructions           String?
  scheduledDate          DateTime
  requestPayload         Json
  responsePayload        Json?
  webhookPayload         Json?
  lastWebhookEventType   String?
  trackingLink           String?
  deliveredAt            DateTime?
  failedAt               DateTime?
  errorMessage           String?
  storeId                String
  store                  Store         @relation(fields: [storeId], references: [id])
  createdById            String
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([storeId, status])
  @@index([externalPlanId])
  @@index([selectedProviderUserId, storeId, scheduledDate])
  @@index([provider, status, scheduledDate])
  // Serves the daily fridge lookup and the same-day duplicate guard, both of
  // which filter by store + scheduled day.
  @@index([storeId, scheduledDate])
}

// Staff-authored reminder that pops up on a chosen day — "pull Ozempic from the
// fridge for Mrs. Kaur". Deliberately NOT tied to a delivery row: fridge items
// often arrive monthly while the delivery profile runs weekly, so a per-profile
// flag would nag on every delivery instead of the day that matters.
model Reminder {
  id          String  @id @default(cuid())
  note        String
  // Optional: picked from the recurring list so the name matches the profile.
  patientName String?
  // Traceability back to the profile the name came from (no FK — a deleted
  // profile must not delete history).
  recurringOrderId String?
  // UTC-midnight day key, matching Order.scheduledDate conventions.
  remindOn    DateTime
  // null = one-off. N = repeat every N weeks; ticking it off spawns the next.
  repeatIntervalWeeks Int?
  // Set on a spawned follow-up so re-ticking can never duplicate the chain.
  sourceReminderId String?
  completedAt   DateTime?
  completedById String?
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Serves the daily popup lookup (open reminders due on/before today).
  @@index([storeId, completedAt, remindOn])
  @@index([sourceReminderId])
}
